# Supabase Public Configuration (Safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SITE_URL=https://riteshprajapati.com.np

# Optional: Deterministic Portfolio Owner Profile ID
# Leave empty to automatically use the first created profile
NEXT_PUBLIC_PORTFOLIO_PROFILE_ID=

# Server-only Supabase Secret Key (NEVER use NEXT_PUBLIC_ for this key!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
